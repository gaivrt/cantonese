{
  "title": "飲食",
  "theme": "dining",
  "level": "intermediate",
  "sections": [
    {
      "title": "一 情境對話：進餐廳",
      "type": "dialogue",
      "units": [
        {
          "cantonese": "歡迎光臨！請問你哋幾位啊？",
          "jyutping": "fun1 jing4 gwong1 lam4! cing2 man6 nei5 dei6 gei2 wai2 aa3?",
          "meaning": "欢迎光临！请问你们几位啊？",
          "speaker": "侍應"
        },
        {
          "cantonese": "三位，唔該！",
          "jyutping": "saam1 wai2, m4 goi1!",
          "meaning": "三位，谢谢！",
          "speaker": "客人"
        },
        {
          "cantonese": "請問你哋有冇訂位啊？",
          "jyutping": "cing2 man6 nei5 dei6 jau5 mou5 deng6 wai2 aa3?",
          "meaning": "请问你们有没有订位啊？",
          "speaker": "侍應"
        },
        {
          "cantonese": "我哋尋日下晝就 book 咗位啦，留咗姓李嘅三位。",
          "jyutping": "ngo5 dei6 cam4 jat6 haa6 zau3 zau6 book zo2 wai6 laa1, lau4 zo2 sing3 lei5 ge3 saam1 wai2.",
          "meaning": "我们昨天下午就订了位了，留了姓李的三位。",
          "speaker": "客人"
        },
        {
          "cantonese": "好，請過嚟呢邊啦！",
          "jyutping": "hou2, cing2 gwo3 lei4 nei4 bin1 laa1!",
          "meaning": "好，请过来这边啦！",
          "speaker": "侍應"
        },
        {
          "cantonese": "唔該攞個餐牌嚟睇睇吓。",
          "jyutping": "m4 goi1 lo2 go3 caan1 paai2 lei4 tai2 haa5.",
          "meaning": "麻烦拿个菜单来看看。",
          "speaker": "客人"
        },
        {
          "cantonese": "好。請問你哋係唔係而家點埋餐啊？",
          "jyutping": "hou2. cing2 man6 nei5 dei6 hai6 m4 hai6 ji4 gaa1 dim2 maai4 sung3 aa3?",
          "meaning": "好。请问你们是不是现在就点餐啊？",
          "speaker": "侍應"
        },
        {
          "cantonese": "等陣先！等我諗諗／睇睇個餐牌先！",
          "jyutping": "dang2 zan6 sin1! dang2 ngo5 nam2 nam2 / tai2 tai2 go3 caan1 paai2 sin1!",
          "meaning": "等一下先！等我想想／看看菜单先！",
          "speaker": "客人"
        },
        {
          "cantonese": "好。",
          "jyutping": "hou2.",
          "meaning": "好。",
          "speaker": "侍應"
        }
      ]
    },
    {
      "title": "一 情境對話：點餐",
      "type": "dialogue",
      "units": [
        {
          "cantonese": "請問你想食啲咩啊？",
          "jyutping": "cing2 man6 nei5 soeng2 sik6 di1 me1 aa1?",
          "meaning": "请问你想吃点什么啊？",
          "speaker": "侍應"
        },
        {
          "cantonese": "要一個叉油雞飯走色，一個乾炒牛河，再加一個咖哩牛腩飯丫唔該。",
          "jyutping": "jiu3 jat1 go3 caa1 jau4 gai1 faan6 zau2 sik1, jat1 go3 gon1 caau2 ngau4 ho4, zoi3 gaa1 jat1 go3 gaa3 lei1 ngau4 naam5 faan6 aa1 m4 goi1.",
          "meaning": "要一个叉油鸡饭走色，一个干炒牛河，再加一个咖喱牛腩饭，谢谢。",
          "speaker": "客人"
        },
        {
          "cantonese": "好。仲有冇其他嘢啊？要唔要加碟油菜？",
          "jyutping": "hou2. zung6 jau5 mou5 kei4 taa1 je5 aa1? jiu3 m4 jiu3 gaa1 dip6 jau4 coi3?",
          "meaning": "好。还有没有其他的啊？要不要加碟油菜？",
          "speaker": "侍應"
        },
        {
          "cantonese": "要碟芥蘭同埋菜心全走。",
          "jyutping": "jiu3 dip6 gaai3 laan2 tung4 maai4 coi3 sam1 cyun4 zau2.",
          "meaning": "要碟芥兰和菜心全走。",
          "speaker": "客人"
        },
        {
          "cantonese": "飲乜嘢？",
          "jyutping": "jam2 mat1 je5?",
          "meaning": "喝什么？",
          "speaker": "侍應"
        },
        {
          "cantonese": "一杯凍奶茶少甜少冰，一杯熱鴛鴦，同埋一杯熱檸蜜。",
          "jyutping": "jat1 bui1 dung3 naai5 caa4 siu2 tim4 siu2 bing1, jat1 bui1 jit6 jyun1 joeng1, tung4 maai4 jat1 bui1 jit6 ning4 mat6.",
          "meaning": "一杯冻奶茶少甜少冰，一杯热鸳鸯，还有一杯热柠蜜。",
          "speaker": "客人"
        },
        {
          "cantonese": "冇問題。",
          "jyutping": "mou5 man6 tai4.",
          "meaning": "没问题。",
          "speaker": "侍應"
        },
        {
          "cantonese": "係咁多，唔該你。",
          "jyutping": "hai6 gam2 do1, m4 goi1 nei5.",
          "meaning": "就这么多，谢谢你。",
          "speaker": "客人"
        }
      ]
    },
    {
      "title": "一 情境對話：結帳",
      "type": "dialogue",
      "units": [
        {
          "cantonese": "伙記，唔該埋單。",
          "jyutping": "fo2 gei3, m4 goi1 maai4 daan1.",
          "meaning": "服务员，请结账。",
          "speaker": "客人"
        },
        {
          "cantonese": "係。多謝二百二十蚊。",
          "jyutping": "hai6. do1 ze6 ji6 baak3 ji6 sap6 man1.",
          "meaning": "好的。多谢二百二十块。",
          "speaker": "侍應"
        },
        {
          "cantonese": "可唔可以碌卡呀？",
          "jyutping": "ho2 m4 ho2 ji5 luk1 kaa1 aa3?",
          "meaning": "可不可以刷卡呀？",
          "speaker": "客人"
        },
        {
          "cantonese": "畀現金同信用卡都得。",
          "jyutping": "bei2 jin6 gam1 tung4 seon3 jung6 kaa1 dou1 dak1.",
          "meaning": "付现金和信用卡都可以。",
          "speaker": "侍應"
        },
        {
          "cantonese": "咁我碌卡啦！",
          "jyutping": "gam2 ngo5 luk1 kaa1 laa1!",
          "meaning": "那我刷卡啦！",
          "speaker": "客人"
        },
        {
          "cantonese": "好嘅。",
          "jyutping": "hou2 ge3.",
          "meaning": "好的。",
          "speaker": "侍應"
        },
        {
          "cantonese": "麻煩你係呢張單度簽名。",
          "jyutping": "maa4 faan4 nei5 hai6 nei4 zoeng1 daan1 dou6 cim1 meng2.",
          "meaning": "麻烦你在这张单上签名。",
          "speaker": "侍應"
        },
        {
          "cantonese": "嗯。",
          "jyutping": "ng6.",
          "meaning": "嗯。",
          "speaker": "客人"
        },
        {
          "cantonese": "多謝晒，歡迎下次再嚟幫襯！",
          "jyutping": "do1 ze6 saai3, fun1 jing4 haa6 ci3 zoi3 lei4 bong1 can3!",
          "meaning": "多谢，欢迎下次再来光顾！",
          "speaker": "侍應"
        },
        {
          "cantonese": "拜拜！",
          "jyutping": "baai1 baai3!",
          "meaning": "拜拜！",
          "speaker": "客人"
        }
      ]
    },
