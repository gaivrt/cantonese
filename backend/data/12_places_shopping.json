{
  "title": "地方與購物",
  "theme": "places_shopping",
  "level": "intermediate",
  "sections": [
    {
      "title": "一 課文",
      "type": "numbered_sentences",
      "units": [
        {
          "cantonese": "你件衫咁靚，喺邊度買㗎？",
          "jyutping": "nei5 gin6 saam1 gam3 leng3, hai2 bin1 dou6 maai5 gaa3?",
          "meaning": "你件衫咁靚，喺邊度買嘅？"
        },
        {
          "cantonese": "喺銅鑼灣廣場，撞啱大減價。",
          "jyutping": "hai2 tung4 lo4 waan1 gwong2 coeng4, zong6 ngaam1 daai6 gaam2 gaa3.",
          "meaning": "在銅鑼灣廣場，碰上大減價。"
        },
        {
          "cantonese": "幾多錢呀？",
          "jyutping": "gei2 do1 cin2 aa3?",
          "meaning": "幾多錢呀？"
        },
        {
          "cantonese": "原價成兩千文，打咗八八折仲要千七。",
          "jyutping": "jyun4 gaa3 seng4 loeng5 cin1 man1, daa2 zo2 baat3 baat3 zit3 zung6 jiu3 cin1 cat1.",
          "meaning": "原價成兩千文，打了八八折仲要千七。"
        },
        {
          "cantonese": "好抵噃。",
          "jyutping": "hou2 dai2 wo3.",
          "meaning": "好抵噃。"
        },
        {
          "cantonese": "不如放咗工，我哋一齊去睇吓吖。",
          "jyutping": "bat1 jyu4 fong3 zo2 gung1, ngo5 dei6 jat1 cai4 heoi3 tai2 haa5 aa1.",
          "meaning": "不如放了工，我們一齊去瞄下吖。"
        },
        {
          "cantonese": "我冇乜錢喺身，",
          "jyutping": "ngo5 mou5 mat1 cin2 hai2 san1,",
          "meaning": "我冇乜錢喺身，"
        },
        {
          "cantonese": "等我過就近嗰間恒生撳啲錢至得。",
          "jyutping": "dang2 ngo5 gwo3 zau6 gan6 go2 gaan1 hang4 saang1 gam6 di1 cin2 zi3 dak1.",
          "meaning": "等我過就近嗰間恒生撳啲錢至得。"
        },
        {
          "cantonese": "使乜特登行一趟嗻，碌咭都得㗎。",
          "jyutping": "sai2 mat1 dak6 dang1 hang4 jat1 tong3 ze1, luk1 kaat1 dou1 dak1 gaa3.",
          "meaning": "使乜特登行一趟嗻，碌卡都得㗎。"
        },
        {
          "cantonese": "係就係，之不過碌咭就冇折頭㗎喇。",
          "jyutping": "hai6 zau6 hai6, zi1 bat1 gwo3 luk1 kaat1 zau6 mou5 zit3 tau4 gaa3 laa3.",
          "meaning": "係就係，之不過碌咭就冇折頭㗎喇。"
        }
      ]
    },
