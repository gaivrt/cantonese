      "type": "numbered_sentences",
      "units": [
        {
          "cantonese": "我個妹至鍾意行街買嘢。",
          "jyutping": "ngo5 go3 mui2 zi3 zung1 ji3 haang4 gaai1 maai5 je5.",
          "meaning": "我妹妹最喜歡逛街買東西。"
        },
        {
          "cantonese": "佢係逢商場必入。",
          "jyutping": "keoi5 hai6 fung4 soeng1 coeng4 bit1 jap6.",
          "meaning": "她什麼商場都要進去。"
        },
        {
          "cantonese": "撞啱大減價，就去掃貨。",
          "jyutping": "zong6 ngaam1 daai6 gaam2 gaa3, zau6 heoi3 sou3 fo3.",
          "meaning": "碰上大甩賣，就使勁買。"
        }
      ]
    },
