        {
          "cantonese": "今日啲巴士離晒譜。",
          "jyutping": "gam1 jat6 di1 baa1 si2 lei4 saai3 pou2.",
          "meaning": "今天的公共汽車亂了套了。"
        },
        {
          "cantonese": "等咗半粒鐘都冇架嚟。",
          "jyutping": "dang2 zo2 bun3 nap1 zung1 dou1 mou5 gaa3 lai4.",
          "meaning": "等了半小時竟然一輛也沒來。"
        },
        {
          "cantonese": "你急佢唔急吖嘛。",
          "jyutping": "nei5 gap1 keoi5 m4 gap1 aa1 maa3.",
          "meaning": "這叫：你急他不急。"
        }
      ]
