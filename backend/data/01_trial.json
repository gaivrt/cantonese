{
  "title": "試堂",
  "theme": "trial",
  "level": "beginner",
  "sections": [
    {
      "title": "一 課文",
      "type": "numbered_sentences",
      "units": [
        {
          "cantonese": "我哋初次見面，認識一下先。",
          "jyutping": "ngo5 dei6 co1 ci3 gin3 min6, jing6 sik1 jat1 haa5 sin1.",
          "meaning": "我们初次见面，认识一下先。"
        },
        {
          "cantonese": "你貴姓呀？",
          "jyutping": "nei5 gwai3 sing3 aa3?",
          "meaning": "你贵姓呀？"
        },
        {
          "cantonese": "呢位先生貴姓呀？",
          "jyutping": "ni1 wai2 sin1 saang1 gwai3 sing3 aa3?",
          "meaning": "这位先生贵姓呀？"
        },
        {
          "cantonese": "嗰位小姐係邊個呀？",
          "jyutping": "go2 wai2 siu2 ze2 hai6 bin1 go3 aa3?",
          "meaning": "那位小姐是哪个呀？"
        },
        {
          "cantonese": "佢叫乜嘢名呀？",
          "jyutping": "keoi5 giu3 mat1 je5 meng2 aa3?",
          "meaning": "他叫什么名字呀？"
        },
        {
          "cantonese": "我姓王，係三畫王，嗰個「Wong」。",
          "jyutping": "ngo5 sing3 wong4, hai6 saam1 waak6 wong4, go2 go3 wong4.",
          "meaning": "我姓王，是三画王，那个「Wong」。"
        },
        {
          "cantonese": "佢姓黃，係黃河嘅「Wong」。",
          "jyutping": "keoi5 sing3 wong4, hai6 wong4 ho4 ge3 wong4.",
          "meaning": "他姓黄，是黄河的「黄」。"
        },
        {
          "cantonese": "我嚟自我介紹一下啦。",
          "jyutping": "ngo5 lai4 zi6 ngo5 gaai3 siu6 jat1 haa5 laa1.",
          "meaning": "我来自我介绍一下啦。"
        },
        {
          "cantonese": "等我嚟介紹一下，呢位係吳先生。",
          "jyutping": "dang2 ngo5 lai4 gaai3 siu6 jat1 haa5, ni1 wai2 hai6 ng4 sin1 saang1.",
          "meaning": "等我来介绍一下，这位是吴先生。"
        },
        {
          "cantonese": "好高興認識你。",
          "jyutping": "hou2 gou1 hing3 jing6 sik1 nei5.",
          "meaning": "好高兴认识你。"
        }
      ]
    },
    {
      "title": "二 「名」在粵語中的異讀現象",
      "type": "grammar_note",
      "units": [
        {
          "cantonese": "名 ming4：姓名 sing3 ming4",
          "jyutping": "ming4",
          "meaning": "名字（名词义）"
        },
        {
          "cantonese": "名 meng2：叫乜嘢名 giu3 mat1 je5 meng2",
          "jyutping": "meng2",
          "meaning": "名字（口语称呼义）"
        }
      ]
    },
    {
      "title": "三 結構助詞：「嘅」",
      "type": "grammar_note",
      "units": [
        {
          "cantonese": "「嘅」相當於普通話中的「的」，一般表示修飾關係及領屬關係。",
          "jyutping": "ge3",
          "meaning": "相当于普通话中的「的」"
        },
        {
          "cantonese": "初次嘅見面",
          "jyutping": "co1 ci3 ge3 gin3 min6",
          "meaning": "初次的见面（修饰关系）"
        },
        {
          "cantonese": "佢嘅名",
          "jyutping": "keoi5 ge3 meng2",
          "meaning": "他的名字（领属关系）"
        },
        {
          "cantonese": "黃河嘅黃",
          "jyutping": "wong4 ho4 ge3 wong4",
          "meaning": "黄河的黄（举例用法）"
        }
      ]
    },
    {
      "title": "四 副詞：「好」",
      "type": "grammar_note",
      "units": [
        {
          "cantonese": "「好」表示程度很高，相當於普通話中的「很」、「非常」、「十分」等。",
          "jyutping": "hou2",
          "meaning": "很、非常、十分"
        },
        {
          "cantonese": "我好好。",
          "jyutping": "ngo5 hou2 hou2.",
          "meaning": "我很好。"
        },
        {
          "cantonese": "啲嘢好貴。",
          "jyutping": "di1 je5 hou2 gwai3.",
          "meaning": "东西很贵。"
        }
      ]
    },
    {
      "title": "五 否定詞",
      "type": "vocab_table",
      "units": [
        {
          "cantonese": "唔",
          "jyutping": "m4",
          "meaning": "不",
          "examples": ["唔知", "唔使（不用）", "好唔好", "係唔係"]
        },
        {
          "cantonese": "冇",
          "jyutping": "mou5",
          "meaning": "沒有",
          "examples": ["有冇", "冇睇過", "冇意見"]
        },
        {
          "cantonese": "未",
          "jyutping": "mei6",
          "meaning": "沒（未完成）",
          "examples": ["得未（好了嗎）", "未睇完", "未去過"]
        },
        {
          "cantonese": "咪",
          "jyutping": "mai5",
          "meaning": "別，不是",
          "examples": ["咪客氣", "咪行咁快（別走這麼快）"]
        }
      ]
    },
    {
      "title": "六 動詞",
      "type": "vocab_table",
      "units": [
        {
          "cantonese": "係",
          "jyutping": "hai6",
          "meaning": "是",
          "examples": ["係唔係", "係邊個", "定係（還是）"]
        },
        {
          "cantonese": "嚟",
          "jyutping": "lai4",
          "meaning": "來",
          "examples": ["入嚟（進來）", "我嚟先", "佢嚟咗（他來了）"]
        },
        {
          "cantonese": "搵",
          "jyutping": "wan2",
          "meaning": "找",
          "examples": ["搵到", "搵乜嘢", "搵邊個"]
        },
        {
          "cantonese": "畀",
          "jyutping": "bei2",
          "meaning": "給",
          "examples": ["畀我", "畀佢", "畀錢我（給我錢）"]
        },
        {
          "cantonese": "企",
          "jyutping": "kei5",
          "meaning": "站",
          "examples": ["企出啲（往外站）", "企入啲（往裏站）", "企定啲（站穩點）"]
        },
        {
          "cantonese": "睇",
          "jyutping": "tai2",
          "meaning": "看",
          "examples": ["睇一睇", "睇見佢", "睇定啲（看準點）"]
        },
        {
          "cantonese": "諗",
          "jyutping": "nam2",
          "meaning": "想",
          "examples": ["諗計（想辦法）", "諗住（想著）", "諗唔起", "諗清楚"]
        },
        {
          "cantonese": "傾",
          "jyutping": "king1",
          "meaning": "談",
          "examples": ["傾偈（聊天）", "傾（一）傾", "傾咗好耐（談了好久）"]
        }
      ]
    },
    {
      "title": "七 形容詞",
      "type": "vocab_table",
      "units": [
        {
          "cantonese": "平",
          "jyutping": "peng4",
          "meaning": "便宜",
          "examples": ["好平", "平價（廉價）", "平到死（便宜得很）"]
        },
        {
          "cantonese": "靚",
          "jyutping": "leng3",
          "meaning": "漂亮",
          "examples": ["好靚", "靚湯（好湯）", "靚到死（漂亮得很）"]
        },
        {
          "cantonese": "正",
          "jyutping": "zeng3",
          "meaning": "不錯",
          "examples": ["好正", "平靚正（便宜美觀又好使）"]
        },
        {
          "cantonese": "啱",
          "jyutping": "ngaam1",
          "meaning": "適合，正好",
          "examples": ["唔啱（不對）", "啱啱好（剛剛好）"]
        },
        {
          "cantonese": "掂",
          "jyutping": "dim6",
          "meaning": "好，順利，沒問題",
          "examples": ["唔掂", "搞掂", "實掂（一定行）"]
        },
        {
          "cantonese": "焗",
          "jyutping": "guk6",
          "meaning": "悶",
          "examples": ["好焗", "又逼又焗（又擠又悶）"]
        }
      ]
    },
