    {
      "title": "一 課文",
      "type": "numbered_sentences",
      "units": [
        {
          "cantonese": "呢個禮拜日得唔得閒呀？",
          "jyutping": "ni1 go3 lai5 baai3 jat6 dak1 m4 dak1 haan4 aa3?",
          "meaning": "这个礼拜日得不得闲呀？"
        },
        {
          "cantonese": "冇乜嘢，想約你一齊去會展中心睇車展嘅。",
          "jyutping": "mou5 mat1 je5, soeng2 joek3 nei5 jat1 cai4 heoi3 wui6 zin2 zung1 sam1 tai2 ce1 zin2 ze1.",
          "meaning": "没什么，想约你一齐去会展中心睇车展嘅。"
        },
        {
          "cantonese": "唔好意思，我有約喇。第二時先啦。",
          "jyutping": "m4 hou2 ji3 si3, ngo5 jau5 joek3 wo3. dai6 ji6 si4 sin1 laa1.",
          "meaning": "不好意思，我有约了。第二时先啦。"
        },
        {
          "cantonese": "第二時即係幾時呀？",
          "jyutping": "dai6 ji6 si4 zik1 hai6 gei2 si4 aa3?",
          "meaning": "第二时即系几时呀？"
        },
        {
          "cantonese": "等我睇下個記事簿先。",
          "jyutping": "dang2 ngo5 tai2 haa5 go3 gei3 si6 bou2 sin1.",
          "meaning": "等我睇下个记事簿先。"
        },
        {
          "cantonese": "下個禮拜日九月廿五號，你得唔得？",
          "jyutping": "haa6 go3 lai5 baai3 jat6 gau2 jyut6 jaa6 ng5 hou6, nei5 dak1 m4 dak1?",
          "meaning": "下个礼拜日九月廿五号，你得唔得？"
        },
        {
          "cantonese": "得，不過你咪話嚟又唔嚟噃。",
          "jyutping": "dak1, bat1 gwo3 nei5 mai5 waa6 lai4 jau6 m4 lai4 bo3.",
          "meaning": "得，不过你咪话嚟又唔嚟噃。"
        },
        {
          "cantonese": "車展到月底咋，去唔到就要等出年。",
          "jyutping": "ce1 zin2 dou3 jyut6 dai2 zaa3, heoi3 m4 dou2 zau6 jiu3 dang2 ceot1 nin2.",
          "meaning": "车展到月底咋，去唔到就要等出年。"
        },
        {
          "cantonese": "應承得你，我實會到。噉，幾點鐘喺邊度等？",
          "jyutping": "jing1 sing4 dak1 nei5, ngo5 sat6 wui5 dou3. gam2, gei2 dim2 zung1 hai2 bin1 dou6 dang2?",
          "meaning": "应承得你，我实会到。噉，几点�的喺边度等？"
        },
        {
          "cantonese": "下晝三點，灣仔地鐵站A出口，如何？",
          "jyutping": "haa6 zau3 saam1 dim2, waan1 zai2 dei6 tit3 zaam6 ei1 ceot1 heo2, jyu4 ho4?",
          "meaning": "下昼三点，湾仔地铁站A出口，如何？"
        }
      ]
    },
