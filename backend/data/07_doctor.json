    {
      "title": "三 補充語彙（二）句子",
      "type": "numbered_sentences",
      "units": [
        {
          "cantonese": "你坐喺度等，姑娘一陣就嚟。",
          "jyutping": "nei5 co5 hai2 dou6 dang2, gu1 noeng4 jat1 zan6 zau6 lai4.",
          "meaning": "你坐这儿等，护士一会儿就过来。"
        },
        {
          "cantonese": "睇街症，輪候時間長。",
          "jyutping": "tai2 gaai1 zing3, leon4 hau6 si4 gaan3 coeng4.",
          "meaning": "看政府门诊医生，等候时间长。"
        },
        {
          "cantonese": "私家診所收費唔平㗎。",
          "jyutping": "si1 gaa1 can2 so2 sau1 fai3 m4 peng4 gaa3.",
          "meaning": "私立诊所收费可不便宜。"
        },
        {
          "cantonese": "佢入咗院，喺度吊緊鹽水。",
          "jyutping": "keoi5 jap6 zo2 jyun2, hai2 dou6 diu3 gan2 jim4 seoi2.",
          "meaning": "他住了院，正在打点滴。"
        },
        {
          "cantonese": "有人暈咗，快啲叫十字車。",
          "jyutping": "jau5 jan4 wan4 zo2, faai3 di1 giu3 sap6 zi6 ce1.",
          "meaning": "有人晕倒，快点儿叫救护车。"
        }
      ]
    },
