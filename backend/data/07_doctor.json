{
  "title": "看醫生",
  "theme": "doctor",
  "level": "intermediate",
  "sections": [
    {
      "title": "一 課文（一）",
      "type": "numbered_sentences",
      "units": [
        {
          "cantonese": "喂，你隻左眼做乜嘢呀？",
          "jyutping": "wai3, nei5 zek3 zo2 ngaan5 zou6 mat1 je5 aa3?",
          "meaning": "喂，你只左眼做什么呀？"
        },
        {
          "cantonese": "哦，開咗刀嘅。",
          "jyutping": "o5, hoi1 zo2 dou1 ze1.",
          "meaning": "哦，开了刀呗。"
        },
        {
          "cantonese": "唔怪（之）得呢排唔見你啦。",
          "jyutping": "m4 gwaai3 zi1 dak1 ni1 paai4 m4 gin3 nei5 laa1.",
          "meaning": "难怪（之）得这阵子不见你啦。"
        },
        {
          "cantonese": "而家覺得點呀？",
          "jyutping": "ji4 gaa1 gok3 dak1 dim2 aa3?",
          "meaning": "现在觉得怎么样？"
        },
        {
          "cantonese": "而家比起啱啱開完刀嗰陣好好多喇。",
          "jyutping": "ji4 gaa1 bei2 hei2 ngaam1 ngaam1 hoi1 jyun4 dou1 go2 zan6 hou2 hou2 do1 laa3.",
          "meaning": "现在比起刚开完刀那会儿好好多了。"
        }
      ]
    },
    {
      "title": "一 課文（二）",
      "type": "numbered_sentences",
      "units": [
        {
          "cantonese": "喂，你上個禮拜三點解唔嚟我屋企呀？",
          "jyutping": "wai3, nei5 soeng6 go3 lai5 baai3 saam1 dim2 gaai2 m4 lai4 ngo5 uk1 kei2 aa3?",
          "meaning": "喂，你上个礼拜三为什么不上我家来呀？"
        },
        {
          "cantonese": "上個禮拜我啲牙唔掂。",
          "jyutping": "soeng6 go3 lai5 baai3 ngo5 di1 ngaa4 m4 dim6.",
          "meaning": "上个礼拜我的牙不行了。"
        },
        {
          "cantonese": "點呀？牙痛呀？",
          "jyutping": "dim2 aa3? ngaa4 tung3 aa4?",
          "meaning": "怎么回事？牙痛呀？"
        },
        {
          "cantonese": "唉，唔知幾辛苦，又打針又食藥。",
          "jyutping": "haai4, m4 zi1 gei2 san1 fu2, jau6 daa2 zam1 jau6 sik6 joeng6.",
          "meaning": "唉，不知几辛苦，又打针又食药。"
        },
        {
          "cantonese": "牙痛慘過大病吖嘛。",
          "jyutping": "ngaa4 tung3 caam2 gwo3 daai6 beng6 aa1 maa3.",
          "meaning": "牙痛惨过大病呀嘛。"
        }
      ]
    },
    {
      "title": "一 課文（三）",
      "type": "numbered_sentences",
      "units": [
        {
          "cantonese": "醫生，我嘅血壓點樣呀？",
          "jyutping": "ji1 sang1, ngo5 ge3 hyut3 aat3 dim2 joeng2 aa3?",
          "meaning": "医生，我的血压怎样呀？"
        },
        {
          "cantonese": "同以前一樣，正常吖。",
          "jyutping": "tung4 ji5 cin4 jat1 joeng6, zing3 soeng4 aa1.",
          "meaning": "同以前一样，正常呀。"
        },
        {
          "cantonese": "我好似仲有啲燒喎。",
          "jyutping": "ngo5 hou2 ci5 zung6 jau5 di1 siu1 wo3.",
          "meaning": "我好似还有点烧喎。"
        },
        {
          "cantonese": "係，卅七度九，冇琴日咁高嘞。",
          "jyutping": "hai6, saa1 aa6 cat1 dou6 gau2, mou5 kam4 jat6 gam3 gou1 lag3.",
          "meaning": "是，三十七度九，没有昨日那么高了。"
        },
        {
          "cantonese": "吓，呢度有兩包藥丸，白色嗰啲一日四次，每次兩粒，黃黃地嗰啲一日三次，每次一粒。飲多啲水，早啲瞓，一兩日就冇事嘅啦。",
          "jyutping": "naa4, ni1 dou6 jau5 loeng5 baau1 joek6 jyun2, baak6 sik1 go2 di1 jat1 jat6 sei3 ci3, mui5 ci3 loeng5 nap1. wong4 wong4 dei2 go2 di1 jat1 jat6 saam1 ci3, mui5 ci3 jat1 nap1. jam2 do1 di1 seoi2, zou2 di1 fan3, jat1 loeng5 jat6 zau6 mou5 si6 gaa3 laa3.",
          "meaning": "呐，这里有两包药丸，白色那些一日四次，每次两粒。黄黄的那些一日三次，每次一粒。饮多点水，早点睡，一两日就没事了。"
        }
      ]
    },
    {
      "title": "普通話對譯（一）",
      "type": "numbered_sentences",
      "units": [
        {
          "cantonese": "（1）你左眼怎麼啦？",
          "jyutping": "",
          "meaning": "你左眼怎么啦？"
        },
        {
          "cantonese": "（2）噢，開了刀呗。",
          "jyutping": "",
          "meaning": "噢，开了刀呗。"
        },
        {
          "cantonese": "（3）難怪這些日子見不着你哪。",
          "jyutping": "",
          "meaning": "难怪这些日子见不着你哪。"
        },
        {
          "cantonese": "（4）現在覺得怎麼樣？",
          "jyutping": "",
          "meaning": "现在觉得怎么样？"
        },
        {
          "cantonese": "（5）現在比剛開完刀那會兒好多了。",
          "jyutping": "",
          "meaning": "现在比刚开完刀那会儿好多了。"
        }
      ]
    },
    {
      "title": "普通話對譯（二）",
      "type": "numbered_sentences",
      "units": [
        {
          "cantonese": "（1）你上星期三為什麼不上我家來？",
          "jyutping": "",
          "meaning": "你上星期三为什么不上我家来？"
        },
        {
          "cantonese": "（2）上星期我的牙疼，來不了。",
          "jyutping": "",
          "meaning": "上星期我的牙疼，来不了。"
        },
        {
          "cantonese": "（3）怎麼回事？",
          "jyutping": "",
          "meaning": "怎么回事？"
        }
      ]
    },
